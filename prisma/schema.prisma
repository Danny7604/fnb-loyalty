datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id            String             @id @default(uuid())
  phone         String             @unique
  fullName      String
  birthDate     DateTime?
  currentPoints Int                @default(0)
  totalSpent    Decimal            @default(0) @db.Decimal(12, 2)
  tierId        String?
  tier          Tier?              @relation(fields: [tierId], references: [id])
  notes         String?
  transactions  PointTransaction[]
  vouchers      CustomerVoucher[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([phone])
}

model Tier {
  id              String     @id @default(uuid())
  name            String     @unique // Đồng, Bạc, Vàng, Kim Cương
  minSpend        Decimal    @db.Decimal(12, 2)
  discountPercent Int        @default(0) // 0%, 5%, 10%
  pointMultiplier Float      @default(1.0) // 1.0, 1.2, 1.5
  color           String     @default("gray")
  benefits        String?
  customers       Customer[]
  createdAt       DateTime   @default(now())
}

model PointTransaction {
  id             String    @id @default(uuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type           String    // "EARN" | "REDEEM" | "ADJUST"
  points         Int       // Dương nếu cộng, âm nếu trừ
  billAmount     Decimal?  @db.Decimal(12, 2)
  billCode       String?   // Mã hóa đơn đối soát
  discountAmount Decimal?  @default(0) @db.Decimal(12, 2)
  staffName      String?   // Tên thu ngân/quản lý tạo
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([customerId])
  @@index([billCode])
}

model Voucher {
  id                String            @id @default(uuid())
  code              String            @unique
  title             String
  description       String?
  discountType      String            // "PERCENT" | "FIXED" | "FREE_ITEM"
  discountValue     Decimal           @db.Decimal(12, 2) // 10% hoặc 50000đ
  freeItemName      String?           // vd: "1 Đĩa Ba Chỉ Bò Mỹ Nướng"
  minOrderAmount    Decimal           @default(0) @db.Decimal(12, 2)
  maxDiscount       Decimal?          @db.Decimal(12, 2)
  startDate         DateTime          @default(now())
  endDate           DateTime
  usageLimit        Int               @default(100)
  usedCount         Int               @default(0)
  isActive          Boolean           @default(true)
  isBirthdayVoucher Boolean           @default(false)
  customers         CustomerVoucher[]
  createdAt         DateTime          @default(now())
}

model CustomerVoucher {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  voucherId  String
  voucher    Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  isUsed     Boolean   @default(false)
  usedAt     DateTime?
  billCode   String?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

model Category {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  displayOrder Int        @default(0)
  icon         String?
  items        MenuItem[]
  createdAt    DateTime   @default(now())
}

model MenuItem {
  id                   String   @id @default(uuid())
  categoryId           String
  category             Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  price                Decimal  @db.Decimal(12, 2)
  memberPrice          Decimal? @db.Decimal(12, 2)
  imageUrl             String?
  isAvailable          Boolean  @default(true)
  isBestSeller         Boolean  @default(false)
  isSignature          Boolean  @default(false)
  spicyLevel           Int      @default(0)
  portion              String?  // "Combo 3-4 người", "Đĩa 250g"
  rewardPointsRequired Int?
  displayOrder         Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([categoryId])
}

model LoyaltySetting {
  id               String   @id @default("default")
  earnRateAmount   Decimal  @default(100000) @db.Decimal(12, 2) // 100.000 VNĐ
  earnRatePoints   Int      @default(10)                       // = 10 điểm
  redeemRatePoint  Int      @default(1)                        // 1 điểm
  redeemRateAmount Decimal  @default(1000) @db.Decimal(12, 2)  // = 1.000 VNĐ
  minRedeemPoints  Int      @default(10)                       // Tối thiểu 10 điểm mới cho tiêu
  updatedAt        DateTime @updatedAt
}

model StaffUser {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  fullName  String
  role      String   @default("CASHIER") // "ADMIN" | "CASHIER"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
